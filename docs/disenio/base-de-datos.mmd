    categoria ||--o{ producto : "clasifica"
    ubicacion |o--o{ producto : "almacena"
    producto ||--|{ codigo_barra : "se_identifica_con"
    producto ||--o{ movimiento_stock : "registra"
    proveedor |o--o{ movimiento_stock : "provee_en"
    usuario ||--o{ movimiento_stock : "carga"
    venta |o--o{ movimiento_stock : "descuenta"
    nota |o--o{ movimiento_stock : "reingresa"
    cliente ||--o| cuenta_corriente : "posee"
    cliente ||--o{ venta : "realiza"
    usuario ||--o{ venta : "vende"
    venta ||--|{ item_venta : "contiene"
    producto ||--o{ item_venta : "es_vendido_en"
    venta ||--o{ autorizacion : "requiere"
    comprobante |o--o{ autorizacion : "requiere"
    usuario ||--o{ autorizacion : "solicita"
    usuario |o--o{ autorizacion : "autoriza"
    cliente ||--o{ comprobante : "recibe"
    usuario ||--o{ comprobante : "emite"
    comprobante ||--o| factura : "se_especializa_en"
    comprobante ||--o| nota : "se_especializa_en"
    comprobante ||--o| recibo : "se_especializa_en"
    venta ||--o| factura : "genera"
    factura ||--o{ nota : "da_origen_a"
    nota ||--o{ item_nota : "contiene"
    producto ||--o{ item_nota : "es_devuelto_en"
    cuenta_corriente ||--o{ movimiento_cuenta_corriente : "acumula"
    comprobante |o--o| movimiento_cuenta_corriente : "impacta_en"
    usuario ||--o{ movimiento_cuenta_corriente : "registra"
    movimiento_cuenta_corriente ||--o{ imputacion : "acredita"
    movimiento_cuenta_corriente ||--o{ imputacion : "es_cancelado_por"
